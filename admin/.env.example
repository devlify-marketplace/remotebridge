# Copy to .env for local runs (python-dotenv is NOT required: `set -a; . ./.env; set +a`).
# On Render these are set in the dashboard / render.yaml instead.

# Neon: Dashboard > your project > Connect > choose the *pooled* connection string.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require

ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-something-long
ORG_ENROLLMENT_KEY=generate-with-python-secrets-token_urlsafe-24
SECRET_KEY=generate-with-python-secrets-token_hex-32

# Shared with the relay (server/relay.py --secret / $RELAY_SECRET). Empty = open relay, no tokens issued.
RELAY_SECRET=generate-with-python-secrets-token_hex-32
# Optional: make relay tokens expire (seconds, or 12h / 7d). Hosts renew them at half-life. Leave unset until
# the relay and every host are upgraded - older hosts can't renew and would be locked out. See server/README.md.
# RELAY_TOKEN_TTL=7d

# Force every operator to set up an authenticator-app code (2FA) before using the console.
# REMOTEBRIDGE_REQUIRE_2FA=1

REMOTEBRIDGE_BEHIND_PROXY=1
REMOTEBRIDGE_SECURE_COOKIES=1
SESSION_EVENT_RETENTION_DAYS=90
